[Unit]
Description=Update Private Jet Emissions Tracker event database from temporary ADS-B Exchange heatmaps
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=adsb
Group=adsb
WorkingDirectory=/opt/pjet
Environment=PJET_DB_DIR=/var/lib/pjet
Environment=PJET_UPDATE_CACHE_DIR=/var/cache/pjet/adsbx
Environment=PJET_UPDATE_STATUS=/var/lib/pjet/update-status.json
Environment=PJET_UPDATE_LOCK=/var/lib/pjet/update.lock
Environment=PJET_BUILDER=/opt/pjet/rust/pjet/target/release/pjet
Environment=PJET_UPDATE_BATCH_SLOTS=48
ExecStart=/usr/bin/node /opt/pjet/scripts/update-events.mjs
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
