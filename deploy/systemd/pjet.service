[Unit]
Description=Private Jet Emissions Tracker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adsb
Group=adsb
WorkingDirectory=/opt/pjet
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=PJET_DB_DIR=/var/lib/pjet
Environment=PJET_UPDATE_STATUS=/var/lib/pjet/update-status.json
Environment=PJET_UPDATE_LOCK=/var/lib/pjet/update.lock
EnvironmentFile=/etc/pjet/secrets.env
ExecStart=/usr/bin/npm run serve -- --host 127.0.0.1 --port 8080 --db-dir /var/lib/pjet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
